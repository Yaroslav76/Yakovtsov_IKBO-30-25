#!/bin/bash

if [ $# -eq 0 ]; then
    echo "Usage: $0 <path>"
    exit 1
fi

find "$1" -type f -exec md5sum {} \; 2>/dev/null > /tmp/hashes.txt
sort /tmp/hashes.txt > /tmp/hashes_sorted.txt
awk '{print $1}' /tmp/hashes_sorted.txt | uniq -d > /tmp/dup_hashes.txt

while read -r hash; do
    echo "Дубликаты (hash $hash):"
    grep "^$hash" /tmp/hashes_sorted.txt
    echo
done < /tmp/dup_hashes.txt

rm /tmp/hashes.txt /tmp/hashes_sorted.txt /tmp/dup_hashes.txt


