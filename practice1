#!/bin/bash

if [ $# -eq 0 ]; then
    echo "Usage: $0 <directory>"
    exit 1
fi

dir="$1"

for file in $(find "$dir" -name "*.c" -o -name "*.js" -o -name "*.py"); do
    first_line=$(head -n 1 "$file")
    ext="${file##*.}"

    if [ "$ext" = "py" ]; then
        if [[ "$first_line" == \#* ]]; then
            echo "OK: $file"
        else
            echo "NO: $file"
        fi
    else
        if [[ "$first_line" == //* || "$first_line" == /\** ]]; then
            echo "OK: $file"
        else
            echo "NO: $file"
        fi
    fi
done




