#!/bin/bash

if [ $# -ne 2 ]; then
    echo "Usage: $0 <directory> <extension>" >&2
    exit 1
fi

dir="$1"
ext="$2"

if [ ! -d "$dir" ]; then
    echo "Error: '$dir' is not a directory" >&2
    exit 1
fi

archive_name="archive_${ext}.tar"

find "$dir" -type f -name "*.${ext}" -print0 | tar -cvf "$archive_name" --null -T -

echo "файлы .tar: $ext заархивированы - $archive_name"
